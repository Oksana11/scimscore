# --- dev.scimscore.com (Plesk) — copy to .env on the server, never commit ---
APP_NAME=SCIMSCORE
APP_ENV=production
APP_DEBUG=false
APP_URL=https://dev.scimscore.com
APP_KEY=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=60
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true

CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# Plesk local mail server
MAIL_MAILER=sendmail
MAIL_FROM_ADDRESS="no-reply@dev.scimscore.com"
MAIL_FROM_NAME="SCIMSCORE"
SCIM_SUPPORT_EMAIL=support@scimscore.com

# Generated on the server: php artisan security:generate-keys
BLIND_INDEX_KEY=
AUDIT_HMAC_KEY=
CSP_ENABLED=true
HSTS_ENABLED=false
TRUSTED_PROXIES=127.0.0.1

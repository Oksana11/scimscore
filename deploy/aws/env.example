# --- AWS (EC2 + RDS) — copy to /var/www/scimscore/.env, never commit ---
APP_NAME=SCIMSCORE
APP_ENV=production
APP_DEBUG=false
APP_URL=https://YOUR-DOMAIN
APP_KEY=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=scimscore-mysql.cjcocq0a8cph.il-central-1.rds.amazonaws.com
DB_PORT=3306
DB_DATABASE=scimscore
DB_USERNAME=scimscore
# Optional: name/ARN of an AWS Secrets Manager secret; deploy.sh then fills DB_PASSWORD,
# MAIL_PASSWORD, … from it (deploy/aws/sync-secrets.sh). Leave empty to keep values here.
SECRETS_ID=
DB_PASSWORD=
# RDS requires TLS; the certificate and host name are verified.
MYSQL_ATTR_SSL_CA=/etc/ssl/rds/global-bundle.pem

SESSION_DRIVER=database
SESSION_LIFETIME=60
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true

CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

MAIL_MAILER=smtp
MAIL_HOST=smtp.sendgrid.net
MAIL_PORT=587
MAIL_USERNAME=apikey
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@scimscore.com"
MAIL_FROM_NAME="SCIMSCORE"
SCIM_SUPPORT_EMAIL=support@scimscore.com

# Generated by first-run.sh
BLIND_INDEX_KEY=
AUDIT_HMAC_KEY=
CSP_ENABLED=true
HSTS_ENABLED=false
# CloudFront in front: "*" (trust the direct peer). Safe ONLY if the EC2 security group
# allows port 80 from the CloudFront prefix list (com.amazonaws.global.cloudfront.origin-facing).
TRUSTED_PROXIES=*
